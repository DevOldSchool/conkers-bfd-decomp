{
  "schema_version": 1,
  "name": "character-model-activity",
  "model_inventory_digest": true,
  "target": {
    "bank": 1,
    "entry": null,
    "segment": null,
    "material_run": null
  },
  "max_events": 1,
  "max_breakpoint_hits": 10000,
  "timeout_seconds": 30,
  "breakpoints": [
    {
      "name": "character-pool-at-graphics-submit",
      "address": "0x10023DF0",
      "flags": 8,
      "decoder": {
        "format": "cbfd-character-pool",
        "memory": "character-pool"
      },
      "memory": [
        {
          "name": "character-pool",
          "address": "0x800CC2D0",
          "length": 20300
        },
        {
          "name": "task",
          "address": "$a2",
          "length": 64
        }
      ],
      "when": [
        {
          "source": "register",
          "name": "a0",
          "equals": 1
        },
        {
          "source": "register",
          "name": "a1",
          "mask": "0xFFFFFFFF",
          "equals": "0x04000FC0"
        },
        {
          "source": "register",
          "name": "a3",
          "equals": 64
        },
        {
          "source": "memory",
          "name": "task",
          "offset": 0,
          "size": 4,
          "endian": "big",
          "equals": 1
        }
      ]
    }
  ]
}
