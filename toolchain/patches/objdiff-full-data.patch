+/// Compare all initialized storage, including anonymous constants and padding.
+/// Only whole-field absolute relocations can replace their encoded addends.
+fn diff_full_data_section(
+    left: &Object, right: &Object, li: usize, ri: usize,
+) -> Result<(SectionDiff, SectionDiff)> {
+    let ls = &left.sections[li];
+    let rs = &right.sections[ri];
+    let mut lb = ls.data.0.clone();
+    let mut rb = rs.data.0.clone();
+    let mut ld = Vec::new();
+    let mut rd = Vec::new();
+    let mut total = 0;
+    let mut matching = 0;
+    for (mut kind, l, r) in diff_data_relocs_for_range(
+        left, right, li, ri, 0..lb.len(), 0..rb.len(),
+    ) {
+        if let (Some(l), Some(r)) = (l, r) {
+            let lw = left.arch.absolute_data_reloc_size(l.relocation.flags);
+            let rw = right.arch.absolute_data_reloc_size(r.relocation.flags);
+            if lw > 0 && lw == rw && l.relocation.flags == r.relocation.flags {
+                let same_destination = match (l.symbol.section, r.symbol.section) {
+                    (Some(a), Some(b)) => section_name_eq(left, right, a, b)
+                        && l.symbol.address.wrapping_add_signed(l.relocation.addend)
+                            .wrapping_sub(left.sections[a].address)
+                        == r.symbol.address.wrapping_add_signed(r.relocation.addend)
+                            .wrapping_sub(right.sections[b].address),
+                    (None, None) => symbol_name_matches(l.symbol, r.symbol)
+                        && l.symbol.address == r.symbol.address
+                        && l.relocation.addend == r.relocation.addend,
+                    _ => false,
+                };
+                kind = if same_destination { DataDiffKind::None } else { DataDiffKind::Replace };
+                if same_destination {
+                    let la = l.relocation.address as usize;
+                    let ra = r.relocation.address as usize;
+                    let lend = la.checked_add(lw).ok_or_else(|| anyhow!("relocation overflow"))?;
+                    let rend = ra.checked_add(rw).ok_or_else(|| anyhow!("relocation overflow"))?;
+                    lb.get_mut(la..lend).ok_or_else(|| anyhow!("relocation outside data"))?.fill(0);
+                    rb.get_mut(ra..rend).ok_or_else(|| anyhow!("relocation outside data"))?.fill(0);
+                }
+            }
+        }
+        total += 1;
+        if kind == DataDiffKind::None { matching += 1; }
+        if let Some(l) = l {
+            let width = left.arch.data_reloc_size(l.relocation.flags) as u64;
+            ld.push(DataRelocationDiff { reloc: l.relocation.clone(), kind,
+                range: l.relocation.address..l.relocation.address + width });
+        }
+        if let Some(r) = r {
+            let width = right.arch.data_reloc_size(r.relocation.flags) as u64;
+            rd.push(DataRelocationDiff { reloc: r.relocation.clone(), kind,
+                range: r.relocation.address..r.relocation.address + width });
+        }
+    }
+    let (ratio, _, _) = diff_data_range(&lb, &rb);
+    let (_, ldata, rdata) = diff_data_range(&ls.data, &rs.data);
+    let extent = lb.len().max(rb.len());
+    let score = if extent + total == 0 { 100.0 } else {
+        (ratio * extent as f32 + matching as f32) / (extent + total) as f32 * 100.0
+    };
+    // Never round an unequal section or relocation set up to perfect credit.
+    let score = if lb == rb && matching == total { 100.0 } else { score.min(99.99999) };
+    Ok((
+        SectionDiff { match_percent: Some(score), data_diff: ldata, reloc_diff: ld },
+        SectionDiff { match_percent: Some(score), data_diff: rdata, reloc_diff: rd },
+    ))
+}
